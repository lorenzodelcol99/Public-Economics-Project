@article{Ohanian1997,
 ISSN = {00028282},
 URL = {http://www.jstor.org/stable/2950852},
 abstract = {During World War II, government expenditures were financed primarily by issuing debt. During the Korean War, expenditures were financed almost exclusively by higher taxes, reflecting President Truman's preference for balanced budgets. This paper evaluates quantitatively the economic effects of the different policies used to finance these two wars. Counterfactual experiments are used to explore the implications of financing World War II like the Korean War, and financing the Korean War like World War II. I find that using a Korean War policy during World War II would have resulted in much lower output and welfare relative to the actual policy.},
 author = {Lee E. Ohanian},
 journal = {The American Economic Review},
 number = {1},
 pages = {23--40},
 publisher = {American Economic Association},
 title = {The Macroeconomic Effects of War Finance in the United States: World War II and the Korean War},
 urldate = {2026-01-06},
 volume = {87},
 year = {1997}
}

